rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'warney.fernandes22@gmail.com',
          'fernandes38mk@gmail.com'
        ];
    }

    function isSeparateShopOwner(workspaceId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && workspaceId == 'gf_lanches'
        && request.auth.token.email == 'gf3163666@gmail.com';
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateStr(d) {
      return d is string
        && d.size() == 10
        && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidPaymentMethod(p) {
      return p is string
        && p in [
          'Dinheiro',
          'Pix',
          'Cartão de débito',
          'Crédito',
          'Cartão de crédito',
          'Outros'
        ];
    }

    function isValidProductCategory(c) {
      return c is string
        && c in ['Lanche', 'Bebida', 'Adicional', 'Outro'];
    }

    function isValidExpenseCategory(c) {
      return c is string
        && c in [
          'Ingredientes',
          'Carnes e hambúrgueres',
          'Pães',
          'Queijos e frios',
          'Bebidas',
          'Embalagens',
          'Gás',
          'Energia',
          'Transporte',
          'Outros'
        ];
    }

    function isValidSettings(data) {
      return data.keys().hasAll([
          'ownerId',
          'establishmentName',
          'xSaladaPrice',
          'dailyGoal',
          'monthlyGoal',
          'startDate',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'establishmentName',
          'xSaladaPrice',
          'dailyGoal',
          'monthlyGoal',
          'startDate',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.establishmentName is string
        && data.establishmentName.size() >= 1
        && data.establishmentName.size() <= 80
        && data.xSaladaPrice is number
        && data.xSaladaPrice > 0
        && data.xSaladaPrice <= 10000
        && data.dailyGoal is number
        && data.dailyGoal >= 0
        && data.dailyGoal <= 1000000
        && data.monthlyGoal is number
        && data.monthlyGoal >= 0
        && data.monthlyGoal <= 10000000
        && isValidDateStr(data.startDate)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'category',
          'unitPrice',
          'countsAsXSalada',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'category',
          'unitPrice',
          'countsAsXSalada',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && isValidProductCategory(data.category)
        && data.unitPrice is number
        && data.unitPrice >= 0
        && data.unitPrice <= 10000
        && data.countsAsXSalada is bool
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCombo(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'description',
          'items',
          'salePrice',
          'estimatedCost',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'description',
          'items',
          'salePrice',
          'estimatedCost',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.description is string
        && data.description.size() <= 240
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 30
        && data.items[0] is map
        && data.salePrice is number
        && data.salePrice > 0
        && data.salePrice <= 100000
        && data.estimatedCost is number
        && data.estimatedCost >= 0
        && data.estimatedCost <= 100000
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSale(data) {
      return data.keys().hasAll([
          'ownerId',
          'date',
          'quantity',
          'unitPrice',
          'totalAmount',
          'paymentMethod',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'date',
          'quantity',
          'unitPrice',
          'totalAmount',
          'paymentMethod',
          'note',
          'saleMode',
          'xSaladaCount',
          'combosCount',
          'items',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidDateStr(data.date)
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 10000
        && data.unitPrice is number
        && data.unitPrice > 0
        && data.unitPrice <= 100000
        && data.totalAmount is number
        && data.totalAmount > 0
        && data.totalAmount <= 10000000
        && isValidPaymentMethod(data.paymentMethod)
        && data.note is string
        && data.note.size() <= 240
        && (!('saleMode' in data) || (data.saleMode is string && data.saleMode in ['individual', 'combo', 'mixed']))
        && (!('xSaladaCount' in data) || (data.xSaladaCount is int && data.xSaladaCount >= 0 && data.xSaladaCount <= 100000))
        && (!('combosCount' in data) || (data.combosCount is int && data.combosCount >= 0 && data.combosCount <= 100000))
        && (!('items' in data) || (data.items is list && data.items.size() <= 50 && (data.items.size() == 0 || data.items[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll([
          'ownerId',
          'description',
          'amount',
          'category',
          'date',
          'paymentMethod',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'description',
          'amount',
          'category',
          'date',
          'paymentMethod',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 160
        && data.amount is number
        && data.amount > 0
        && data.amount <= 10000000
        && isValidExpenseCategory(data.category)
        && isValidDateStr(data.date)
        && isValidPaymentMethod(data.paymentMethod)
        && data.note is string
        && data.note.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Root collections for MGW Lanches (warney.fernandes22@gmail.com & fernandes38mk@gmail.com)
    match /settings/{settingId} {
      allow get: if isVerifiedAdmin()
        && isValidId(settingId)
        && (settingId == 'mgw_lanches' || settingId == request.auth.uid);

      allow list: if isVerifiedAdmin();

      allow create: if isVerifiedAdmin()
        && isValidId(settingId)
        && (settingId == 'mgw_lanches' || settingId == request.auth.uid)
        && isValidSettings(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedAdmin()
        && isValidId(settingId)
        && (settingId == 'mgw_lanches' || settingId == request.auth.uid)
        && isValidSettings(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'establishmentName',
          'xSaladaPrice',
          'dailyGoal',
          'monthlyGoal',
          'startDate',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isVerifiedAdmin() && isValidId(productId);
      allow list: if isVerifiedAdmin();

      allow create: if isVerifiedAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'category',
          'unitPrice',
          'countsAsXSalada',
          'active',
          'updatedAt'
        ]);

      allow delete: if isVerifiedAdmin() && isValidId(productId);
    }

    match /combos/{comboId} {
      allow get: if isVerifiedAdmin() && isValidId(comboId);
      allow list: if isVerifiedAdmin();

      allow create: if isVerifiedAdmin()
        && isValidId(comboId)
        && isValidCombo(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedAdmin()
        && isValidId(comboId)
        && isValidCombo(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'items',
          'salePrice',
          'estimatedCost',
          'active',
          'updatedAt'
        ]);

      allow delete: if isVerifiedAdmin() && isValidId(comboId);
    }

    match /sales/{saleId} {
      allow get: if isVerifiedAdmin()
        && isValidId(saleId);

      allow list: if isVerifiedAdmin();

      allow create: if isVerifiedAdmin()
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedAdmin()
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'date',
          'quantity',
          'unitPrice',
          'totalAmount',
          'paymentMethod',
          'note',
          'saleMode',
          'xSaladaCount',
          'combosCount',
          'items',
          'updatedAt'
        ]);

      allow delete: if isVerifiedAdmin()
        && isValidId(saleId);
    }

    match /expenses/{expenseId} {
      allow get: if isVerifiedAdmin()
        && isValidId(expenseId);

      allow list: if isVerifiedAdmin();

      allow create: if isVerifiedAdmin()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedAdmin()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'description',
          'amount',
          'category',
          'date',
          'paymentMethod',
          'note',
          'updatedAt'
        ]);

      allow delete: if isVerifiedAdmin()
        && isValidId(expenseId);
    }

    // Isolated workspace for separate shop account (gf3163666@gmail.com)
    match /workspaces/{workspaceId}/settings/{settingId} {
      allow get: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(settingId)
        && settingId == 'main';

      allow list: if false;

      allow create: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(settingId)
        && settingId == 'main'
        && isValidSettings(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(settingId)
        && settingId == 'main'
        && isValidSettings(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'establishmentName',
          'xSaladaPrice',
          'dailyGoal',
          'monthlyGoal',
          'startDate',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /workspaces/{workspaceId}/products/{productId} {
      allow get: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(productId);

      allow list: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId);

      allow create: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'category',
          'unitPrice',
          'countsAsXSalada',
          'active',
          'updatedAt'
        ]);

      allow delete: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(productId);
    }

    match /workspaces/{workspaceId}/combos/{comboId} {
      allow get: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(comboId);

      allow list: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId);

      allow create: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(comboId)
        && isValidCombo(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(comboId)
        && isValidCombo(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'description',
          'items',
          'salePrice',
          'estimatedCost',
          'active',
          'updatedAt'
        ]);

      allow delete: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(comboId);
    }

    match /workspaces/{workspaceId}/sales/{saleId} {
      allow get: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(saleId);

      allow list: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId);

      allow create: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'date',
          'quantity',
          'unitPrice',
          'totalAmount',
          'paymentMethod',
          'note',
          'saleMode',
          'xSaladaCount',
          'combosCount',
          'items',
          'updatedAt'
        ]);

      allow delete: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(saleId);
    }

    match /workspaces/{workspaceId}/expenses/{expenseId} {
      allow get: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(expenseId);

      allow list: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId);

      allow create: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'description',
          'amount',
          'category',
          'date',
          'paymentMethod',
          'note',
          'updatedAt'
        ]);

      allow delete: if isSeparateShopOwner(workspaceId)
        && isValidId(workspaceId)
        && isValidId(expenseId);
    }
  }
}
