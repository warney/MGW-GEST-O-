{
  "entities": {
    "Settings": {
      "title": "Configurações da Lanchonete",
      "description": "Configurações operacionais e metas financeiras exclusivas do proprietário.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID do proprietário autenticado",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "establishmentName": {
          "type": "string",
          "description": "Nome do estabelecimento",
          "minLength": 1,
          "maxLength": 80
        },
        "xSaladaPrice": {
          "type": "number",
          "description": "Preço unitário padrão do X-Salada em reais"
        },
        "dailyGoal": {
          "type": "number",
          "description": "Meta diária de faturamento em reais"
        },
        "monthlyGoal": {
          "type": "number",
          "description": "Meta mensal de faturamento em reais"
        },
        "startDate": {
          "type": "string",
          "description": "Data de início das operações no formato YYYY-MM-DD",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor"
        }
      },
      "required": [
        "ownerId",
        "establishmentName",
        "xSaladaPrice",
        "dailyGoal",
        "monthlyGoal",
        "startDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Produto da Lanchonete",
      "description": "Produto individual utilizado em vendas diretas e composição de combos.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID do proprietário autenticado",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Nome do produto",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "description": "Categoria do produto",
          "enum": ["Lanche", "Bebida", "Adicional", "Outro"]
        },
        "unitPrice": {
          "type": "number",
          "description": "Preço unitário de venda individual em reais"
        },
        "countsAsXSalada": {
          "type": "boolean",
          "description": "Indica se cada unidade deste produto contabiliza como X-Salada vendido"
        },
        "active": {
          "type": "boolean",
          "description": "Status ativo ou inativo do produto"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL HTTPS pública da foto do produto no Supabase Storage (bucket mgw-cardapios)",
          "maxLength": 1000
        },
        "imagePath": {
          "type": "string",
          "description": "Caminho canônico isolado do arquivo no bucket mgw-cardapios dentro de tenants/{workspaceId}/products/{productId}/",
          "maxLength": 260
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor"
        }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "unitPrice",
        "countsAsXSalada",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "Combo": {
      "title": "Combo Promocional",
      "description": "Combo composto por produtos e quantidades configuráveis.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID do proprietário autenticado",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Nome do combo",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Descrição do combo",
          "maxLength": 240
        },
        "items": {
          "type": "array",
          "description": "Lista de produtos e quantidades que compõem o combo"
        },
        "salePrice": {
          "type": "number",
          "description": "Preço de venda do combo em reais"
        },
        "estimatedCost": {
          "type": "number",
          "description": "Custo estimado opcional do combo em reais"
        },
        "active": {
          "type": "boolean",
          "description": "Status ativo ou inativo do combo"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL HTTPS pública da foto do combo no Supabase Storage (bucket mgw-cardapios)",
          "maxLength": 1000
        },
        "imagePath": {
          "type": "string",
          "description": "Caminho canônico isolado do arquivo no bucket mgw-cardapios dentro de tenants/{workspaceId}/combos/{comboId}/",
          "maxLength": 260
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor"
        }
      },
      "required": [
        "ownerId",
        "name",
        "description",
        "items",
        "salePrice",
        "estimatedCost",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "Sale": {
      "title": "Venda / Pedido",
      "description": "Registro individual de venda com cópia imutável de combos e produtos vendidos.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID do proprietário autenticado",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "description": "Data da venda no formato YYYY-MM-DD",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "quantity": {
          "type": "integer",
          "description": "Quantidade base legada ou total de itens principais"
        },
        "unitPrice": {
          "type": "number",
          "description": "Preço unitário médio ou do item"
        },
        "totalAmount": {
          "type": "number",
          "description": "Valor total da venda calculado"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Forma de pagamento",
          "enum": ["Dinheiro", "Pix", "Cartão de débito", "Crédito", "Cartão de crédito", "Outros"]
        },
        "note": {
          "type": "string",
          "description": "Observação opcional sobre a venda",
          "maxLength": 240
        },
        "saleMode": {
          "type": "string",
          "description": "Tipo da venda: individual, combo ou mista",
          "enum": ["individual", "combo", "mixed"]
        },
        "xSaladaCount": {
          "type": "integer",
          "description": "Total de X-Saladas contabilizados nesta venda (individuais + combos)"
        },
        "combosCount": {
          "type": "integer",
          "description": "Total de combos vendidos neste pedido"
        },
        "items": {
          "type": "array",
          "description": "Cópia histórica dos combos e produtos vendidos no momento da venda"
        },
        "saleOrigin": {
          "type": "string",
          "description": "Origem da venda: manual ou cardápio online",
          "enum": ["manual", "online"]
        },
        "onlineOrderId": {
          "type": "string",
          "description": "ID do pedido online vinculado quando concluído",
          "minLength": 1,
          "maxLength": 128
        },
        "onlineOrderNumber": {
          "type": "integer",
          "description": "Número sequencial do pedido online vinculado"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Taxa de entrega incluída no total da venda online"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor"
        }
      },
      "required": [
        "ownerId",
        "date",
        "quantity",
        "unitPrice",
        "totalAmount",
        "paymentMethod",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Despesa da Lanchonete",
      "description": "Registro de despesa operacional ou compra de insumos.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID do proprietário autenticado",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "description": {
          "type": "string",
          "description": "Descrição da despesa",
          "minLength": 1,
          "maxLength": 160
        },
        "amount": {
          "type": "number",
          "description": "Valor em reais"
        },
        "category": {
          "type": "string",
          "description": "Categoria da despesa",
          "enum": [
            "Ingredientes",
            "Carnes e hambúrgueres",
            "Pães",
            "Queijos e frios",
            "Bebidas",
            "Embalagens",
            "Gás",
            "Energia",
            "Transporte",
            "Outros"
          ]
        },
        "date": {
          "type": "string",
          "description": "Data da despesa no formato YYYY-MM-DD",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Forma de pagamento",
          "enum": ["Dinheiro", "Pix", "Cartão de débito", "Crédito", "Cartão de crédito", "Outros"]
        },
        "note": {
          "type": "string",
          "description": "Observação opcional sobre a despesa",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor"
        }
      },
      "required": [
        "ownerId",
        "description",
        "amount",
        "category",
        "date",
        "paymentMethod",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "DigitalMenuSettings": {
      "title": "Configurações do Cardápio Digital",
      "description": "Configurações operacionais e link público do cardápio digital por estabelecimento.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_\\-]{1,63}$"
        },
        "isActive": { "type": "boolean" },
        "isOpen": { "type": "boolean" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "phoneWhatsapp": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 240 },
        "openingHours": { "type": "string", "maxLength": 160 },
        "pixKey": { "type": "string", "maxLength": 140 },
        "deliveryFee": { "type": "number" },
        "minimumOrderAmount": { "type": "number" },
        "acceptsDelivery": { "type": "boolean" },
        "acceptsPickup": { "type": "boolean" },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "logoPath": { "type": "string", "maxLength": 260 },
        "bannerUrl": { "type": "string", "maxLength": 1000 },
        "bannerPath": { "type": "string", "maxLength": 260 },
        "nextOrderSeq": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "slug",
        "isActive",
        "isOpen",
        "storeName",
        "description",
        "phoneWhatsapp",
        "address",
        "openingHours",
        "deliveryFee",
        "minimumOrderAmount",
        "acceptsDelivery",
        "acceptsPickup",
        "nextOrderSeq",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicMenu": {
      "title": "Snapshot Público do Cardápio Digital",
      "description": "Projeção pública somente-leitura com produtos e combos ativos para o cardápio online sem autenticação.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "enum": ["mgw_lanches", "gf_lanches"] },
        "slug": { "type": "string", "minLength": 2, "maxLength": 64 },
        "isActive": { "type": "boolean" },
        "isOpen": { "type": "boolean" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "phoneWhatsapp": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 240 },
        "openingHours": { "type": "string", "maxLength": 160 },
        "pixKey": { "type": "string", "maxLength": 140 },
        "deliveryFee": { "type": "number" },
        "minimumOrderAmount": { "type": "number" },
        "acceptsDelivery": { "type": "boolean" },
        "acceptsPickup": { "type": "boolean" },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "bannerUrl": { "type": "string", "maxLength": 1000 },
        "products": { "type": "array" },
        "combos": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId",
        "slug",
        "isActive",
        "isOpen",
        "storeName",
        "description",
        "phoneWhatsapp",
        "address",
        "openingHours",
        "deliveryFee",
        "minimumOrderAmount",
        "acceptsDelivery",
        "acceptsPickup",
        "products",
        "combos",
        "updatedAt"
      ]
    },
    "OnlineOrder": {
      "title": "Pedido Online Recebido",
      "description": "Pedido efetuado pelo cardápio digital com fluxo completo de atendimento e vínculo financeiro idempotente.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string", "enum": ["mgw_lanches", "gf_lanches"] },
        "menuSlug": { "type": "string", "minLength": 2, "maxLength": 64 },
        "orderNumber": { "type": "integer" },
        "orderCode": { "type": "string", "minLength": 3, "maxLength": 24 },
        "tokenHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "accepted",
            "preparing",
            "ready",
            "out_for_delivery",
            "ready_for_pickup",
            "completed",
            "rejected",
            "cancelled"
          ]
        },
        "fulfillmentType": { "type": "string", "enum": ["delivery", "pickup"] },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 8, "maxLength": 32 },
        "deliveryAddress": { "type": "string", "maxLength": 280 },
        "deliveryReference": { "type": "string", "maxLength": 160 },
        "paymentMethod": { "type": "string", "enum": ["Pix", "Dinheiro", "Cartão"] },
        "changeFor": { "type": ["number", "null"] },
        "customerNote": { "type": "string", "maxLength": 300 },
        "subtotalAmount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "viewedAtMs": { "type": ["integer", "null"] },
        "acceptedAtMs": { "type": ["integer", "null"] },
        "preparingAtMs": { "type": ["integer", "null"] },
        "readyAtMs": { "type": ["integer", "null"] },
        "dispatchedAtMs": { "type": ["integer", "null"] },
        "completedAtMs": { "type": ["integer", "null"] },
        "cancelledAtMs": { "type": ["integer", "null"] },
        "saleId": { "type": ["string", "null"], "maxLength": 128 },
        "items": { "type": "array" },
        "statusHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceId",
        "menuSlug",
        "orderNumber",
        "orderCode",
        "tokenHash",
        "status",
        "fulfillmentType",
        "customerName",
        "customerPhone",
        "deliveryAddress",
        "deliveryReference",
        "paymentMethod",
        "customerNote",
        "subtotalAmount",
        "deliveryFee",
        "totalAmount",
        "rejectionReason",
        "items",
        "statusHistory",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicOrderTracking": {
      "title": "Acompanhamento Público do Pedido",
      "description": "Documento indexado pelo hash SHA-256 do token secreto do pedido para acompanhamento em tempo real.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workspaceId": { "type": "string", "enum": ["mgw_lanches", "gf_lanches"] },
        "tokenHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "orderNumber": { "type": "integer" },
        "orderCode": { "type": "string", "minLength": 3, "maxLength": 24 },
        "status": {
          "type": "string",
          "enum": [
            "received",
            "accepted",
            "preparing",
            "ready",
            "out_for_delivery",
            "ready_for_pickup",
            "completed",
            "rejected",
            "cancelled"
          ]
        },
        "fulfillmentType": { "type": "string", "enum": ["delivery", "pickup"] },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "deliveryAddress": { "type": "string", "maxLength": 280 },
        "deliveryReference": { "type": "string", "maxLength": 160 },
        "paymentMethod": { "type": "string", "enum": ["Pix", "Dinheiro", "Cartão"] },
        "changeFor": { "type": ["number", "null"] },
        "customerNote": { "type": "string", "maxLength": 300 },
        "subtotalAmount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "storeSlug": { "type": "string", "minLength": 2, "maxLength": 64 },
        "storeWhatsapp": { "type": "string", "maxLength": 32 },
        "storeAddress": { "type": "string", "maxLength": 240 },
        "storePixKey": { "type": "string", "maxLength": 140 },
        "items": { "type": "array" },
        "statusHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId",
        "workspaceId",
        "tokenHash",
        "orderNumber",
        "orderCode",
        "status",
        "fulfillmentType",
        "customerName",
        "deliveryAddress",
        "deliveryReference",
        "paymentMethod",
        "customerNote",
        "subtotalAmount",
        "deliveryFee",
        "totalAmount",
        "rejectionReason",
        "storeName",
        "storeSlug",
        "storeWhatsapp",
        "storeAddress",
        "items",
        "statusHistory",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/Settings"
      },
      "description": "Configurações da lanchonete MGW Lanches pertencentes ao proprietário"
    },
    "/digital_menu_settings/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/DigitalMenuSettings"
      },
      "description": "Configurações do cardápio digital por workspace"
    },
    "/public_menus/{menuSlug}": {
      "schema": {
        "$ref": "#/entities/PublicMenu"
      },
      "description": "Projeção pública do cardápio ativo acessível sem autenticação por slug"
    },
    "/online_orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/OnlineOrder"
      },
      "description": "Pedidos online recebidos pela MGW Lanches"
    },
    "/public_order_tracking/{tokenHash}": {
      "schema": {
        "$ref": "#/entities/PublicOrderTracking"
      },
      "description": "Acompanhamento em tempo real de pedidos via hash SHA-256 do token"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Cadastro permanente de produtos individuais"
    },
    "/combos/{comboId}": {
      "schema": {
        "$ref": "#/entities/Combo"
      },
      "description": "Cadastro permanente de combos promocionais"
    },
    "/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Histórico permanente de vendas e pedidos"
    },
    "/expenses/{expenseId}": {
      "schema": {
        "$ref": "#/entities/Expense"
      },
      "description": "Histórico permanente de despesas operacionais e insumos"
    },
    "/workspaces/{workspaceId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/Settings"
      },
      "description": "Configurações isoladas de lanchonete separada por workspace"
    },
    "/workspaces/{workspaceId}/online_orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/OnlineOrder"
      },
      "description": "Pedidos online isolados de lanchonete separada por workspace"
    },
    "/workspaces/{workspaceId}/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Produtos isolados de lanchonete separada por workspace"
    },
    "/workspaces/{workspaceId}/combos/{comboId}": {
      "schema": {
        "$ref": "#/entities/Combo"
      },
      "description": "Combos isolados de lanchonete separada por workspace"
    },
    "/workspaces/{workspaceId}/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Vendas isoladas de lanchonete separada por workspace"
    },
    "/workspaces/{workspaceId}/expenses/{expenseId}": {
      "schema": {
        "$ref": "#/entities/Expense"
      },
      "description": "Despesas isoladas de lanchonete separada por workspace"
    }
  }
}
